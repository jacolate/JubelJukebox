# Copy to .env – used by `npm run dev` and by `docker compose`. Never commit .env.

# Code guests enter on /login (case-insensitive, at least 6 characters)
ENTRY_CODE=CHANGEME1

# DJ login on /admin – create the hash with: npm run hash-password
ADMIN_USERNAME=dj
ADMIN_PASSWORD_HASH=

# Spotify app (https://developer.spotify.com/dashboard), client credentials flow
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# SQLite database file (default: data/jukebox.db; the container uses /app/data/jukebox.db)
# DATABASE_PATH=data/jukebox.db
