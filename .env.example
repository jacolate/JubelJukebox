# Copy to .env – used by `npm run dev` and by `docker compose` / `podman-compose`. Never commit .env.

# --- Container setup (compose.yaml) ---
# Public domain; Caddy gets a Let's Encrypt certificate for it. Use localhost for a local test.
DOMAIN=localhost
# Host ports. Keep 80/443 in production; rootless Podman needs ports above 1024, e.g. 8080/8443.
HTTP_PORT=80
HTTPS_PORT=443

# --- App ---

# Code guests enter on /login (case-insensitive, at least 6 characters)
ENTRY_CODE=CHANGEME1

# DJ login on /admin – create the hash with: npm run hash-password
ADMIN_USERNAME=dj
ADMIN_PASSWORD_HASH=

# Spotify app from https://developer.spotify.com/dashboard – see "Spotify credentials" in README.md
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# SQLite database file (default: data/jukebox.db; the container uses /app/data/jukebox.db)
# DATABASE_PATH=data/jukebox.db
