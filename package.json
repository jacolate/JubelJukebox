{
	"name": "jubel-jukebox",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie custom-request baseLocale --emit-ts-declarations --silent",
		"check": "npm run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"hash-password": "node scripts/hash-password.ts",
		"test:e2e": "npm run build && playwright test",
		"test:visual": "npm run build && VISUAL=1 playwright test --project=visual"
	},
	"dependencies": {
		"uqr": "^0.1.3",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^3.2.1",
		"@inlang/plugin-message-format": "^4.6.0",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"daisyui": "^5.7.50",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
